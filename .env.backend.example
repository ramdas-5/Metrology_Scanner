# =====================================================================
# BACKEND environment (FastAPI + MongoDB)
# =====================================================================
# Copy to .env.backend and fill in the real values:
#     cp .env.backend.example .env.backend
#
# For the Render deployment you do NOT ship this file - paste these keys into
# Render -> your service -> Environment (they are already listed in
# render.yaml, which marks the secrets as "sync: false").
#
# Priority: real environment variables > .env.backend > .env

# Secret used to sign JWT auth tokens - CHANGE THIS in production
# (Render: use "generateValue" or paste a long random string).
SECRET_KEY=dafdbafuafugbfkuibfkuiwbuikwbfuikwyh

# Access token lifetime in minutes (7 days = 10080; raise/lower as you like)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------
# Database - MongoDB
# ---------------------------------------------------------------
# MongoDB Atlas: copy the connection string from
#   Atlas -> Database -> Connect -> Drivers -> Python
# and replace <password> with the database user's password. Keep the
# password out of source control: only ever put the real value in
# .env.backend (git-ignored) or in the hosting provider's env vars.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Logical database name inside that cluster.
MONGODB_DB=metrology

# Bootstrap admin: created automatically on first start when the users
# collection is empty. Change the password right after the first login.
ADMIN_EMAIL=admin@metrology.gov.in
ADMIN_PASSWORD=admin123
ADMIN_NAME=System Administrator

# ---------------------------------------------------------------
# CORS - which frontends may call this API
# ---------------------------------------------------------------
# Local dev + the deployed frontend. Comma separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app
# Also accept any https://*.vercel.app origin (preview deployments).
CORS_ALLOW_VERCEL=true

# ---------------------------------------------------------------
# ML model
# ---------------------------------------------------------------
# Set to false on small instances (e.g. Render's 512MB tier) to skip loading
# TensorFlow entirely; scans then run OCR + AI/rules without the extra
# label-classifier signal.
CLASSIFIER_ENABLED=true

# Path to the trained Keras label classifier
MODEL_PATH=app/ml/label_classifier.h5

# Class names for the classifier output, in index order (softmax has 2 units)
MODEL_CLASS_NAMES=Non-Compliant Label,Compliant Label

# Path to the tesseract binary. Leave blank to use the one on PATH
# (the Docker image installs it, so leave blank in deployment).
TESSERACT_CMD=

# ---------------------------------------------------------------
# OCR - "give it basically any image and extract as much text as possible"
# ---------------------------------------------------------------
# Which OCR engine to use when a scan image is uploaded:
#   auto      -> PaddleOCR if installed, otherwise Tesseract (recommended)
#   paddle    -> PaddleOCR only (needs: pip install -r requirements-optional.txt)
#   tesseract -> pytesseract, merging several page-segmentation modes
OCR_ENGINE=auto

# ---------------------------------------------------------------
# AI structured extraction - OpenRouter
# ---------------------------------------------------------------
# Get a free key at https://openrouter.ai/keys
# Leave empty to disable the AI pipeline (the app then uses the regex parser
# + deterministic rule engine exactly as before).
OPENROUTER_API_KEY=

# OpenRouter-compatible base URL and chat model. Swap OPENROUTER_MODEL for
# any model id OpenRouter serves (e.g. openai/gpt-4o-mini, google/gemini-flash-1.5,
# meta-llama/llama-3.1-8b-instruct:free) - the response format stays identical.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Timeout in seconds for a single OpenRouter request
AI_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------
# Dedupe / cache - reduce API calls
# ---------------------------------------------------------------
# When the OCR text of a new image is >= this % similar (0-100) to an already
# saved scan, the saved result is returned from the DB and NO AI call is made.
SIMILARITY_THRESHOLD=80

# Only compare the new OCR text against the most recent N saved scans
SIMILARITY_SEARCH_LIMIT=500

# ---------------------------------------------------------------
# Storage (uploads + generated reports)
# ---------------------------------------------------------------
# Relative to the project root. On hosts with an ephemeral filesystem
# (Render, Fly, ...) mount a persistent disk here and point UPLOAD_DIR /
# REPORTS_DIR at the mount path, e.g. /var/data/uploads.
UPLOAD_DIR=app/uploads
REPORTS_DIR=app/reports
