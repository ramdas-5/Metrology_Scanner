

# Secret used to sign JWT auth tokens - CHANGE THIS in production
SECRET_KEY=dafdbafuafugbfkuibfkuiwbuikwbfuikwyh

# Access token lifetime in minutes (7 days = 10080; raise/lower as you like)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite database file (relative to backend root) - swap for Postgres URL in production
DATABASE_URL=sqlite:///./metrology.db

# Comma separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to the trained Keras label classifier
MODEL_PATH=app/ml/label_classifier.h5

# Class names for the classifier output, in index order (softmax has 2 units)
MODEL_CLASS_NAMES=Non-Compliant Label,Compliant Label

# Path to the tesseract binary. Leave blank to use the one on PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------------------------------------------------------------
# OCR - "give it basically any image and extract as much text as possible"
# ---------------------------------------------------------------
# Which OCR engine to use when a scan image is uploaded:
#   auto      -> PaddleOCR if installed, otherwise Tesseract (recommended)
#   paddle    -> PaddleOCR only (needs: pip install -r requirements-optional.txt)
#   tesseract -> pytesseract, merging several page-segmentation modes
OCR_ENGINE=auto

# ---------------------------------------------------------------
# AI structured extraction - OpenRouter
# ---------------------------------------------------------------
# Get a free key at https://openrouter.ai/keys
# Leave empty to disable the AI pipeline (the app then uses the regex parser
# + deterministic rule engine exactly as before).
OPENROUTER_API_KEY=

# OpenRouter-compatible base URL and chat model. Swap OPENROUTER_MODEL for
# any model id OpenRouter serves (e.g. openai/gpt-4o-mini, google/gemini-flash-1.5,
# meta-llama/llama-3.1-8b-instruct:free) - the response format stays identical.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Timeout in seconds for a single OpenRouter request
AI_TIMEOUT_SECONDS=90

# ---------------------------------------------------------------
# Dedupe / cache - reduce API calls
# ---------------------------------------------------------------
# When the OCR text of a new image is >= this % similar (0-100) to an already
# saved scan, the saved result is returned from the DB and NO AI call is made.
SIMILARITY_THRESHOLD=80

# Only compare the new OCR text against the most recent N saved scans
SIMILARITY_SEARCH_LIMIT=500
