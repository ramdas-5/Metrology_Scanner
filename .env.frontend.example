# =====================================================================
# FRONTEND environment (React + Vite)
# =====================================================================
# Copy to .env.frontend and fill in the real value:
#     cp .env.frontend.example .env.frontend
#
# Only VITE_* keys belong in this file - they end up in the browser bundle,
# so NEVER put a secret (MongoDB URI, SECRET_KEY, OpenRouter key) here. Those
# live in .env.backend / the Render dashboard.
#
# For the Vercel deployment you do NOT ship this file - paste the key below
# into Vercel -> Project -> Settings -> Environment Variables (Production,
# Preview and Development). A value set there always wins over this file.
#
# Priority: real environment variables (Vercel) > .env.frontend > .env
#
# NOTE: Vite inlines VITE_* values at BUILD time, so changing the API URL
# requires a new deployment/rebuild.

# Base URL of the backend API, WITHOUT a trailing slash.
#
# Local development (backend on your machine):
VITE_API_URL=http://localhost:8000
#
# Deployed (Vercel frontend -> Render backend):
# VITE_API_URL=https://metrology-backend.onrender.com
