# =====================================================================
# Secrets / environment files
# =====================================================================
# The real values stay out of git; only the .example templates are committed.
.env
.env.backend
.env.frontend
.env.local
.env.*.local
*.env
!.env.backend.example
!.env.frontend.example

# =====================================================================
# Backend (Python / FastAPI)
# =====================================================================
__pycache__/
*.pyc
venv/
.venv/
.venv311/
env/
.pytest_cache/
.mypy_cache/
*.db
*.sqlite3
app/uploads/*
!app/uploads/.gitkeep
app/reports/*
!app/reports/.gitkeep

# =====================================================================
# Frontend (React / Vite)
# =====================================================================
node_modules/
dist/
dist-ssr/
*.local
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =====================================================================
# Editors / OS
# =====================================================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
